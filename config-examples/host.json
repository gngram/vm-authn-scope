{
  "ca_cert_path": "/etc/authn-scope/ca/ca-cert.pem",
  "ca_key_path": "/etc/authn-scope/ca/ca-key.pem",
  "server_port": 900,
  "cert_validity_days": 365,
  "vms": {
    "vm-frontend": {
      "vm_cid": 42,
      "entities": {
        "frontend-api": {
          "caps": [
            {
              "target_vm": "vm-backend",
              "rpc_modules": [
                "auth",
                "storage"
              ],
              "rpc_methods": [
                "auth.login",
                "auth.logout",
                "storage.read"
              ],
              "paths": [
                {
                  "path": "/api/v1/data",
                  "access": [
                    "read"
                  ]
                },
                {
                  "path": "/api/v1/files",
                  "access": [
                    "read",
                    "write"
                  ]
                }
              ]
            }
          ],
          "validity_days": 365
        },
        "metrics-collector": {
          "caps": [
            {
              "target_vm": "vm-backend",
              "rpc_modules": [
                "metrics"
              ],
              "rpc_methods": [
                "metrics.push"
              ],
              "paths": [
                {
                  "path": "/metrics/push",
                  "access": [
                    "write"
                  ]
                }
              ]
            }
          ]
        }
      }
    },
    "vm-backend": {
      "vm_cid": 10,
      "entities": {
        "backend-db": {
          "caps": [
            {
              "target_vm": "vm-storage",
              "rpc_modules": [
                "db"
              ],
              "rpc_methods": [
                "db.query",
                "db.exec"
              ],
              "paths": [
                {
                  "path": "/db/query",
                  "access": [
                    "read",
                    "write"
                  ]
                }
              ]
            }
          ]
        }
      }
    }
  }
}